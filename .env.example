# ===== 환경 =====
ENV=local                      # local | production

# ===== API Keys =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DISCORD_BOT_TOKEN=
# 선택: 개발용 서버(길드) ID. 지정하면 슬래시 커맨드가 그 서버에 즉시 반영됨.
# 비워두면 전역 동기화되지만 디스코드 쪽 반영에 최대 1시간 걸릴 수 있음.
DISCORD_GUILD_ID=

# ===== 데이터 경로 =====
# 로컬 개발: 기본값(./data) 그대로 사용
# 클라우드(Railway/Fly.io) 배포 시: 마운트된 볼륨 경로로 교체 (예: /data)
DATA_DIR=./data

# ===== 데모 모드 =====
# true로 설정하면 실 데이터 대신 별도의 demo DB/벡터스토어 경로를 사용
DEMO_MODE=false

LOG_LEVEL=INFO

# ===== 선택 =====
# 지정 시 DATA_DIR 계산을 무시하고 이 URL을 그대로 사용 (예: 외부 Postgres 등으로 교체 시)
# DATABASE_URL=sqlite:////absolute/path/career_copilot.db
